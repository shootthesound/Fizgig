# Internal dev docs
CLAUDE.md

# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Local config (created on first run)
prefs.json
last_used.json
.last_used.json

# User presets (per-machine, never repo content). The BUILT-IN presets live in code
# (BUILT_IN_PRESETS / KREA2_BUILT_IN_PRESETS in lora_trainer_gui.py), so nothing here
# needs shipping — only the folders themselves, kept alive by their .gitkeep.
presets/.last_train_settings.json
presets/**/*.json
!presets/**/.gitkeep

# Dataset TOMLs (auto-generated)
dataset/*
!dataset/.gitkeep

# Diagnostic dumps
repair_studio_last_preview.log

# Training output / cache (large files)
output_loras/*
!output_loras/.gitkeep
cache/*
!cache/.gitkeep
profiles/*
!profiles/.gitkeep

# Pause state
.fizgig_paused.json

# Model files (user-provided)
*.safetensors
# ...except the bundled silu(t_emb) grid (5.5 MB, Apache-2.0, from larryvrh's
# ComfyUI-MiniMax-H3-Turbo node): the pruned base cannot compute silu(t_emb), and the
# Turbo LoRA's AdaLN injection for previews needs the full model's answer.
!src/fizgig/assets/h3_silu_temb_grid.safetensors
*.ckpt
*.bin

